{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {
    "世界": {
      "日期": 1,
      "时间段": "上午",
      "位置": "邻居家",
      "鸣人状态": "不在家"
    },
    "雏田": {
      "好感度": 40,
      "顺从度": 20,
      "堕落度": 10,
      "关系阶段": "普通",
      "生理日程": "安全日"
    }
  },
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "日期": {
          "type": "number"
        },
        "时间段": {
          "type": "string",
          "enum": [
            "早晨",
            "上午",
            "下午",
            "傍晚",
            "夜晚"
          ]
        },
        "位置": {
          "type": "string",
          "enum": [
            "鸣人家",
            "邻居家",
            "街道与商业区",
            "火影楼",
            "温泉澡堂",
            "忍者学校",
            "其他"
          ]
        },
        "鸣人状态": {
          "type": "string",
          "enum": [
            "在家",
            "不在家"
          ]
        }
      },
      "required": [
        "日期",
        "时间段",
        "位置",
        "鸣人状态"
      ]
    },
    "雏田": {
      "type": "object",
      "properties": {
        "好感度": {
          "type": "number"
        },
        "顺从度": {
          "type": "number"
        },
        "堕落度": {
          "type": "number"
        },
        "关系阶段": {
          "type": "string",
          "enum": [
            "普通",
            "动摇并越界",
            "沉沦",
            "受精怀孕"
          ]
        },
        "生理日程": {
          "type": "string",
          "enum": [
            "安全日",
            "排卵日"
          ]
        }
      },
      "required": [
        "好感度",
        "顺从度",
        "堕落度",
        "关系阶段",
        "生理日程"
      ]
    }
  },
  "required": [
    "世界",
    "雏田"
  ]
}