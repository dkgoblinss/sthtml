{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {
    "系统": {
      "当前日期": "C.E.75年4月1日",
      "当前时间": "09:00",
      "当前地点": "孔帕斯基地",
      "剧情阶段": "FREEDOM开始"
    },
    "拉克丝": {
      "好感度": 0,
      "淫乱出轨值": 0,
      "生理日程": {
        "当前状态": "安全日",
        "周期天数": 1
      },
      "受孕欲望": 0
    },
    "露娜玛利亚": {
      "好感度": 0,
      "淫乱出轨值": 0,
      "生理日程": {
        "当前状态": "安全日",
        "周期天数": 1
      },
      "受孕欲望": 0
    },
    "卡嘉丽": {
      "好感度": 0,
      "淫乱出轨值": 0,
      "生理日程": {
        "当前状态": "安全日",
        "周期天数": 1
      },
      "受孕欲望": 0
    },
    "原作关系状态": {
      "基拉与拉克丝": "稳定",
      "阿斯兰与卡嘉丽": "稳定",
      "真飞鸟与露娜玛利亚": "稳定"
    }
  },
  "type": "object",
  "properties": {
    "系统": {
      "type": "object",
      "properties": {
        "当前日期": {
          "type": "string",
          "description": "当前游戏内日期，格式：C.E.XX年XX月XX日"
        },
        "当前时间": {
          "type": "string",
          "description": "当前游戏内时间，格式：HH:MM"
        },
        "当前地点": {
          "type": "string",
          "description": "当前场景位置"
        },
        "剧情阶段": {
          "type": "string",
          "description": "当前处于原作剧情的哪个阶段"
        }
      },
      "required": [
        "当前日期",
        "当前时间",
        "当前地点",
        "剧情阶段"
      ]
    },
    "拉克丝": {
      "$ref": "#/$defs/__schema0"
    },
    "露娜玛利亚": {
      "$ref": "#/$defs/__schema0"
    },
    "卡嘉丽": {
      "$ref": "#/$defs/__schema0"
    },
    "原作关系状态": {
      "type": "object",
      "properties": {
        "基拉与拉克丝": {
          "type": "string",
          "enum": [
            "稳定",
            "裂痕",
            "破裂"
          ],
          "description": "基拉与拉克丝的关系状态"
        },
        "阿斯兰与卡嘉丽": {
          "type": "string",
          "enum": [
            "稳定",
            "裂痕",
            "破裂"
          ],
          "description": "阿斯兰与卡嘉丽的关系状态"
        },
        "真飞鸟与露娜玛利亚": {
          "type": "string",
          "enum": [
            "稳定",
            "裂痕",
            "破裂"
          ],
          "description": "真飞鸟与露娜玛利亚的关系状态"
        }
      },
      "required": [
        "基拉与拉克丝",
        "阿斯兰与卡嘉丽",
        "真飞鸟与露娜玛利亚"
      ]
    }
  },
  "required": [
    "系统",
    "拉克丝",
    "露娜玛利亚",
    "卡嘉丽",
    "原作关系状态"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "好感度": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "对<user>的好感度"
        },
        "淫乱出轨值": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "淫乱程度与出轨意愿"
        },
        "生理日程": {
          "type": "object",
          "properties": {
            "当前状态": {
              "type": "string",
              "enum": [
                "安全日",
                "排卵日"
              ],
              "description": "当前生理状态"
            },
            "周期天数": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "当前周期第几天"
            }
          },
          "required": [
            "当前状态",
            "周期天数"
          ]
        },
        "受孕欲望": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "受孕欲望百分比（计算字段）"
        }
      },
      "required": [
        "好感度",
        "淫乱出轨值",
        "生理日程",
        "受孕欲望"
      ]
    }
  }
}